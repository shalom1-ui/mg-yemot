# ---- פרטי חשבון MG iSMART "ראשי" (אתה) ----
# החשבון הזה עדיין עובד בלי שום הגדרה נוספת, בתור "משתמש ברירת מחדל" שמזוהה
# לפי הקוד הסודי (YEMOT_PIN) - תמיד נדרש, גם ממספר טלפון מוכר, כדי שגניבת
# הטלפון לבדה לא תספיק. ראו את _legacy_user ב-yemot_bridge.py. משתמשים
# נוספים מתווספים דרך טופס האינטרנט ב-POST /signup/<ADMIN_TOKEN> (ראו
# למטה), לא דרך משתני סביבה.
SAIC_USER=your_ismart_email@example.com
SAIC_PASSWORD=your_ismart_password
# eu הוא ברירת המחדל של הספרייה; לחשבון ישראלי מצאנו ש-tr הוא מה שבאמת עובד
# (ראו research/NOTES.md), יחד עם SAIC_REST_URI למטה
SAIC_REGION=tr
SAIC_REST_URI=https://gateway-mg-il.soimt.com/api.app/v1/

# אופציונלי - ה-VIN מתגלה אוטומטית בשיחה הראשונה אם לא מוגדר כאן
MG_VEHICLE_ID=

# ---- הגנה על התפריט הטלפוני ----
# מחרוזת סודית אקראית - ניתן ליצור עם: openssl rand -hex 16
YEMOT_TOKEN=REPLACE_WITH_RANDOM_SECRET
# קוד סודי בן 4 ספרות שיוקלד בתחילת כל שיחה (עבור החשבון הראשי בלבד) -
# תמיד נדרש, גם ממספר טלפון מוכר
YEMOT_PIN=1234

# ---- ריבוי משתמשים (2026-09-15) ----
# מפתח הצפנה לסיסמאות החשבונות המאוחסנות במסד הנתונים - ליצור עם:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# מחרוזת סודית שמגינה על טופס ההרשמה POST/GET /signup/<ADMIN_TOKEN> -
# ליצור עם: openssl rand -hex 16
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
# איפה נשמר מסד הנתונים של המשתמשים - ב-Render יש דיסק מחובר ב-/data
# (מוגדר ב-render.yaml), אין צורך לשנות. לריצה מקומית אפשר קובץ בתיקייה
# הנוכחית, למשל DB_PATH=./mg_yemot.db
DB_PATH=/data/mg_yemot.db

# ---- פנימי ----
# ה-mg-gateway/mosquitto עדיין רצים ברקע (סוקרים את החשבון הראשי באופן שוטף
# ל-Home Assistant וכו') אבל הברידג' של הטלפון כבר לא משתמש ב-MQTT בכלל -
# הוא פונה ישירות לענן של MG לכל פקודה. שלוש השורות האלה רלוונטיות רק
# ל-mg-gateway עצמו, ורק אם משתמשים בנתיב ה-VPS הישן עם docker-compose (כמה
# קונטיינרים נפרדים) - ב-Render (הקונטיינר המשולב) יש להן ברירת מחדל נכונה.
MQTT_URI=tcp://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
# PORT - ב-Render זה נקבע אוטומטית על ידם, אין צורך להגדיר בעצמכם.
# BRIDGE_PORT - שימושי רק אם מריצים ידנית בלי Render/Docker בכלל.
BRIDGE_PORT=8000
