# ---- פרטי חשבון MG iSMART ----
SAIC_USER=your_ismart_email@example.com
SAIC_PASSWORD=your_ismart_password
# eu הוא ברירת המחדל; אם לא עובד נסה au או tr
SAIC_REGION=eu

# אחרי שמריצים פעם ראשונה ורואים בלוגים של mg-gateway את רשימת כלי הרכב,
# למלא כאן את ה-vehicle_id שמופיע בנושאי ה-MQTT, וכן את חשבון ה-MQTT (בדרך
# כלל גרסה מנורמלת של האימייל שלך - גם זה יופיע בלוגים)
MG_ACCOUNT=your_ismart_email_normalized
MG_VEHICLE_ID=REPLACE_ME_AFTER_FIRST_RUN

# ---- הגנה על התפריט הטלפוני ----
# מחרוזת סודית אקראית - ניתן ליצור עם: openssl rand -hex 16
YEMOT_TOKEN=REPLACE_WITH_RANDOM_SECRET
# קוד סודי בן 4 ספרות שיוקלד בתחילת השיחה
YEMOT_PIN=1234
# מספרי הטלפון המורשים להשתמש בתפריט, מופרדים בפסיקים, בלי רווחים
# (בפורמט כפי שימות המשיח שולח ב-ApiPhone, בד"כ 05XXXXXXXX)
YEMOT_ALLOWED_NUMBERS=0501234567

# ---- פנימי ----
# ב-Render (הקונטיינר המשולב) - אין צורך לגעת בשלוש השורות האלה, יש להן
# ברירת מחדל נכונה בקוד (127.0.0.1). הן רלוונטיות רק אם משתמשים בנתיב ה-VPS
# הישן עם docker-compose (כמה קונטיינרים נפרדים).
MQTT_URI=tcp://mosquitto:1883
MQTT_HOST=mosquitto
MQTT_PORT=1883
# PORT - ב-Render זה נקבע אוטומטית על ידם, אין צורך להגדיר בעצמכם.
# BRIDGE_PORT - שימושי רק אם מריצים ידנית בלי Render/Docker בכלל.
BRIDGE_PORT=8000
